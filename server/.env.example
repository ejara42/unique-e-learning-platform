# ==============================================================================
# EduSphere Enterprise Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network & Core Runtime
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# Comma-separated list of allowed frontend origins (e.g. Cloudflare Pages URL)
CORS_ORIGIN=https://unique-e-learning-platform.pages.dev,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & JWT Token Authentication
# ------------------------------------------------------------------------------
# In production, must be at least 32 characters and NOT default.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. MongoDB Persistence Cluster (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection String format:
# mongodb+srv://<db-username>:<db-password>@<cluster-domain>/edusphere?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.gf7opul.mongodb.net/edusphere_staging?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. Redis Cluster (Task Queue & Session Caching via BullMQ / Upstash)
# ------------------------------------------------------------------------------
# Direct TCP Redis (e.g., Upstash TLS or managed Redis instance)
REDIS_HOST=literate-mudfish-83263.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_TLS=true
REDIS_URL=rediss://default:<password>@literate-mudfish-83263.upstash.io:6379

# Optional Upstash REST fallback (if using Upstash REST SDK)
UPSTASH_REDIS_REST_URL="https://literate-mudfish-83263.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAUU_AAIgcDIxMmE5MmU3YjY4ZTA0ZDVjYTA2Zjg4ZDA3YjUyNDk0Ng"

# ------------------------------------------------------------------------------
# 5. LiveKit WebRTC SFU Server Subsystem
# ------------------------------------------------------------------------------
# Obtain from your LiveKit Cloud project dashboard: https://cloud.livekit.io
LIVEKIT_API_KEY=APIWaMx6hKgEKcB
LIVEKIT_API_SECRET=5sBtceMfXuflJP2dhUz3uzVlMWXZYz07QagXwxvgM75A
LIVEKIT_URL=wss://unique-e-learning-yor6o23p.livekit.cloud

# ------------------------------------------------------------------------------
# 6. Stripe Connect Monetization & Payouts Engine
# ------------------------------------------------------------------------------
# Obtain from Stripe Dashboard (Developers -> API Keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_webhook_secret
STRIPE_COMMISSION_PCT=15

# ------------------------------------------------------------------------------
# 7. S3-Compatible Object Storage (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT=s3.us-east-1.amazonaws.com
S3_BUCKET_NAME=edusphere-media-production
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 8. Educational Interoperability (LTI 1.3 Advantage)
# ------------------------------------------------------------------------------
LTI_CLIENT_ID=edusphere_lti_client_prod
LTI_ISSUER=https://lms.yourinstitution.edu

# ------------------------------------------------------------------------------
# 9. Initial Platform Administrator Bootstrap (Optional for initial setup)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@edusphere.local
INITIAL_ADMIN_PASSWORD=replace-with-secure-admin-password-min-12-chars
INITIAL_ADMIN_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# 10. Security Notes
# ------------------------------------------------------------------------------
# - Never commit .env files to git.
# - Use MongoDB Atlas credentials from a dedicated staging/production user with least-privilege.
# - Ensure Render Web Service environment variables are kept encrypted and restricted.
# - Use test Stripe keys for staging, live Stripe keys only for production.
