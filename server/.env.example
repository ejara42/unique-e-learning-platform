# ==============================================================================
# EduSphere Enterprise Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network & Core Runtime
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=staging
CORS_ORIGIN=https://staging.example.com

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & JWT Token Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. MongoDB Persistence Cluster (Atlas-ready)
# ------------------------------------------------------------------------------
# MongoDB Atlas example:
# mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/edusphere?retryWrites=true&w=majority&appName=edusphere-staging
# Local development example:
# mongodb://localhost:27017/edusphere
MONGODB_URI=mongodb+srv://<ejarawo_db_user>:<iB1ReTMF6hbVQHa5>@cluster0.6sgse3x.mongodb.net/?compressors=zlib

# ------------------------------------------------------------------------------
# 4. Redis Cluster (Task Queue & Session Caching)
# ------------------------------------------------------------------------------
# For Upstash / TLS-enabled Redis, use the full URL form below in your real .env
# Example: redis-cli --tls -u redis://default:<UPSTASH_PASSWORD>@literate-mudfish-83263.upstash.io:6379
# Upstash also exposes REST API credentials used by some SDKs / server integrations
# (not the same as the redis-cli connection string):

REDIS_HOST=literate-mudfish-83263.upstash.io
REDIS_PORT=6379
UPSTASH_REDIS_REST_URL="https://literate-mudfish-83263.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAUU_AAIgcDIxMmE5MmU3YjY4ZTA0ZDVjYTA2Zjg4ZDA3YjUyNDk0Ng"
REDIS_TLS=true

# ------------------------------------------------------------------------------
# 5. LiveKit WebRTC SFU Server Subsystem
# ------------------------------------------------------------------------------
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_URL=wss://livekit.example.com

# ------------------------------------------------------------------------------
# 6. Stripe Connect Monetization & Payouts Engine
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_with_real_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_webhook_secret
STRIPE_COMMISSION_PCT=15

# ------------------------------------------------------------------------------
# 7. S3-Compatible Object Storage (AWS S3 / MinIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT=s3.us-east-1.amazonaws.com
S3_BUCKET_NAME=edusphere-media-staging
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 8. Educational Interoperability (LTI 1.3 Advantage)
# ------------------------------------------------------------------------------
LTI_CLIENT_ID=edusphere_lti_client_staging
LTI_ISSUER=https://staging.example.com

# ------------------------------------------------------------------------------
# 9. Initial Platform Administrator Bootstrap (Optional for headless deploy)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@yourinstitution.edu
INITIAL_ADMIN_PASSWORD=replace-with-secure-admin-password-min-12-chars
INITIAL_ADMIN_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# 10. Security Notes
# ------------------------------------------------------------------------------
# - Never commit .env files to git.
# - Use MongoDB Atlas credentials from a dedicated staging user.
# - Use test Stripe keys only for staging; never use live payment credentials.
# - Do not use real production data or production database credentials in staging.
