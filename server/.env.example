# ==============================================================================
# EduSphere Enterprise Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network & Core Runtime
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://app.edusphere.io

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & JWT Token Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. Database Persistence Cluster (MongoDB Replica Set)
# ------------------------------------------------------------------------------
# Format: mongodb://[username:password@]host1[:port1][,...hostN[:portN]][/[defaultauthdb][?options]]
MONGODB_URI=mongodb://localhost:27017/edusphere?replicaSet=rs0&readPreference=primaryPreferred

# ------------------------------------------------------------------------------
# 4. Redis Cluster (Task Queue & Session Caching)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. LiveKit WebRTC SFU Server Subsystem
# ------------------------------------------------------------------------------
LIVEKIT_API_KEY=your-production-livekit-api-key
LIVEKIT_API_SECRET=your-production-livekit-api-secret
LIVEKIT_URL=wss://livekit.edusphere.io

# ------------------------------------------------------------------------------
# 6. Stripe Connect Monetization & Payouts Engine
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_COMMISSION_PCT=15

# ------------------------------------------------------------------------------
# 7. S3-Compatible Object Storage (AWS S3 / MinIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT=s3.us-east-1.amazonaws.com
S3_BUCKET_NAME=edusphere-media-production
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 8. Educational Interoperability (LTI 1.3 Advantage)
# ------------------------------------------------------------------------------
LTI_CLIENT_ID=edusphere_lti_client_prod
LTI_ISSUER=https://edusphere.io

# ------------------------------------------------------------------------------
# 9. Initial Platform Administrator Bootstrap (Optional for headless deploy)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@yourinstitution.edu
INITIAL_ADMIN_PASSWORD=replace-with-secure-admin-password-min-12-chars
INITIAL_ADMIN_NAME=Platform Administrator
