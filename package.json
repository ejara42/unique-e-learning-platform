{
  "name": "edusphere-platform",
  "version": "1.0.0",
  "description": "EduSphere - Secure, Scalable & Interoperable Web-Based E-Learning Platform",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:all": "npm run build:server && npm run build:client",
    "test:server": "npm --prefix server test",
    "test:security": "npm --prefix server run test:security",
    "test:api": "npm --prefix server run test:api",
    "test:integration": "npm --prefix server run test:integration",
    "test:queue": "npm --prefix server run test:queue",
    "test:drm": "npm --prefix server run test:drm",
    "test:client": "npm --prefix client test",
    "test:e2e": "npm --prefix client run test:e2e",
    "test:release-gate": "node scripts/releaseGate.mjs",
    "test:all": "npm --prefix server run test:all"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
