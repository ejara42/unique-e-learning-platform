# ==============================================================================
# EduSphere Client Environment Configuration Template
# ==============================================================================

# Backend API Base URL
# - Local Development: /api (proxied to http://localhost:5000 by Vite)
# - Cloudflare Pages Production: https://<your-render-app>.onrender.com/api
VITE_API_URL=/api

# Application Metadata
VITE_APP_NAME="EduSphere - Unified E-Learning Platform"
VITE_APP_ENV=development

# WebRTC & Real-time WebSocket Signaling URL
# - Local Development: ws://localhost:5000
# - Production: wss://<your-render-app>.onrender.com
VITE_WS_URL=ws://localhost:5000
