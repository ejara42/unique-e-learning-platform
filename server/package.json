{
  "name": "edusphere-server",
  "version": "1.0.0",
  "description": "EduSphere Backend API Server - Node.js, Express, TypeScript, MongoDB",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node ./node_modules/tsx/dist/cli.mjs tests/phase_a_mongodb.test.ts",
    "test:all": "node ./node_modules/tsx/dist/cli.mjs tests/full_enterprise_suite.test.ts",
    "test:security": "node ./node_modules/tsx/dist/cli.mjs tests/production_security_suite.test.ts",
    "test:enterprise": "node ./node_modules/tsx/dist/cli.mjs tests/enterprise_phase1_upgrades.test.ts",
    "test:phase-b": "node ./node_modules/tsx/dist/cli.mjs tests/phase_b_infrastructure.test.ts",
    "test:integration": "node ./node_modules/tsx/dist/cli.mjs tests/integration/mongodb_replica.test.ts",
    "test:api": "node ./node_modules/tsx/dist/cli.mjs tests/api/multi_tenant_http.test.ts",
    "test:queue": "node ./node_modules/tsx/dist/cli.mjs tests/queue/queue_concurrency.test.ts",
    "test:drm": "node ./node_modules/tsx/dist/cli.mjs tests/media/drm_playback_lifecycle.test.ts",
    "bootstrap:admin": "node ./node_modules/tsx/dist/cli.mjs src/scripts/bootstrapAdmin.ts",
    "reset:admin": "node ./node_modules/tsx/dist/cli.mjs src/scripts/resetAdminPassword.ts",
    "verify:dr": "node ./node_modules/tsx/dist/cli.mjs src/scripts/verifyBackupRestore.ts",
    "worker": "node ./node_modules/tsx/dist/cli.mjs src/worker/transcodeWorker.ts",
    "worker:prod": "node dist/worker/transcodeWorker.js",
    "smoke:test": "node ./node_modules/tsx/dist/cli.mjs scripts/productionSmokeTest.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "stripe": "^23.0.1",
    "uuid": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}